---
import type { CustomerProfile } from "../types/profile";
import SkipLink from "../components/shared/SkipLink.astro";
import WeThruFooter from "../components/profile/WeThruFooter.astro";
import { hasEnglish } from "../utils/i18n";
import "../styles/global.css";
import "../styles/profile-base.css";
import "../styles/themes/navy-black-white.css";
import "../styles/themes/warm-editorial.css";
import "../styles/themes/graphite-minimal.css";
import "../styles/themes/cobalt-air.css";
import "../styles/themes/terracotta-atelier.css";

interface Props {
  customer: CustomerProfile;
}

const { customer } = Astro.props;
const { seo, person } = customer;
const bilingual = hasEnglish(customer);

// No canonical / og:url on customer profiles — on purpose.
//
// These pages are never part of the public career build (CUSTOMER_PROFILES gates
// them out) and they are noindex, so there is no public URL to declare. The
// global `site` is https://career.wethru.com, where /profiles/{slug}/ does not
// and must not exist; stamping that as canonical would advertise a 404. And
// profile.wethru.com is a separate WeThru service this repo does not deploy to,
// so it is not an origin for these pages either.
//
// A delivery build serves them from whatever origin they are handed over on, so
// the honest markup is a relative og:image and no absolute self-reference at all.
const ogImagePath = seo.ogImage || undefined;
---

<html
  lang="ko"
  data-lang="ko"
  data-effects="on"
  data-theme={customer.theme}
  data-layout={customer.layout}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Re-apply the saved interaction-effects choice before first paint so a
      // returning "off" visitor never sees hover effects flash on. Runs on
      // every profile; the default stays "on" when unset or storage is blocked.
      (function () {
        try {
          var fx = localStorage.getItem("wethru-profile-effects");
          if (fx === "on" || fx === "off") {
            document.documentElement.dataset.effects = fx;
          }
        } catch (error) {
          /* storage blocked — keep the server-rendered "on" default */
        }
      })();
    </script>
    {bilingual && (
      // Re-apply the saved language before first paint so an EN visitor
      // never sees a Korean flash. Ko-only profiles skip this entirely —
      // their data-lang stays "ko" no matter what localStorage says.
      <script is:inline>
        (function () {
          try {
            var lang = localStorage.getItem("wethru-profile-lang");
            if (lang === "en" || lang === "ko") {
              document.documentElement.dataset.lang = lang;
              document.documentElement.lang = lang;
            }
          } catch (error) {
            /* storage blocked — keep the server-rendered Korean default */
          }
        })();
      </script>
    )}
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Every customer profile — draft AND published — stays out of search.
        These pages carry the customer's real name, face, employer, and (when
        showEmail/links are on) their email and social URLs. They are a delivered
        artifact meant to be handed to a recruiter by link, not a public document
        a stranger can find by searching the person's name. Sharing the URL still
        works exactly as before; only crawler discovery is removed.
        `status` no longer affects indexing at all — it stays in the data as the
        publish gate for the operator dashboard.
        noindex is not access control, so the pages themselves are additionally
        gated out of any public build (CUSTOMER_PROFILES — see profiles/[slug]). */}
    <meta name="robots" content="noindex, nofollow" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:site_name" content="WeThru Profile" />
    <meta property="og:locale" content="ko_KR" />
    {ogImagePath && <meta property="og:image" content={ogImagePath} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {ogImagePath && <meta name="twitter:image" content={ogImagePath} />}

    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={person.name} />
  </head>
  <body>
    <div class="profile-shell">
      <SkipLink />
      <main id="main" class="profile-main">
        <slot />
      </main>
      <WeThruFooter />
    </div>
  </body>
</html>
