---
import WeThruFooter from "../components/profile/WeThruFooter.astro";
import { campusOffer, approvedCampusCases } from "../data/campus";
import "../styles/global.css";
import "../styles/profile-base.css";
import "../styles/themes/cobalt-air.css";
import "../styles/campus.css";

// Internal case-review mode. Off by default, so a normal `npm run build`
// (including every Vercel deploy) produces the PRODUCTION page. Turn it on
// only for local review:  CAMPUS_REVIEW=1 npm run build  (or npm run dev).
// Read the build-time env without depending on @types/node globals.
const nodeEnv = (
  globalThis as { process?: { env?: Record<string, string | undefined> } }
).process?.env;
const REVIEW_MODE = nodeEnv?.CAMPUS_REVIEW === "1";

const { hero, difference, products, reviewNote, faqs, applyFormUrl } =
  campusOffer;

// Cases: production shows only consented ones (currently none). Review mode
// additionally surfaces the unapproved candidates behind a "배포 금지" banner.
// Gating is server-side, so unapproved names never enter the production HTML.
const visibleCases = REVIEW_MODE ? campusOffer.cases : approvedCampusCases;
const showCases = visibleCases.length > 0;

const applyReady = applyFormUrl !== null;
// No verified apply URL yet, or an internal review build → keep it out of index.
const noindex = !applyReady || REVIEW_MODE;

const caseHref = (c: (typeof campusOffer.cases)[number]): string | undefined =>
  c.slug ? `/profiles/${c.slug}/` : (c.externalUrl ?? undefined);

const site = Astro.site ?? new URL("https://career.wethru.com");
const canonicalUrl = new URL("/campus/", site);

const seoTitle = "WeThru Campus — 얼리버드 커리어 프로필";
const seoDescription =
  "흩어진 경험을 읽히는 순서로 정리한 나만의 커리어 웹페이지. 얼리버드 커리어 프로필(49,000원)과 Interview Portfolio(199,000원) 두 가지로 시작합니다.";
---

<html lang="ko" data-theme="cobalt-air" data-effects="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="WeThru Campus" />
    <meta property="og:locale" content="ko_KR" />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="profile-shell">
      <a class="skip-link" href="#main">본문으로 건너뛰기</a>

      <nav class="campus-nav" aria-label="Campus">
        <a class="campus-nav__brand" href="#top">
          <span class="campus-nav__mark" aria-hidden="true">W</span>
          WeThru Campus
        </a>
        <div class="campus-nav__links">
          <a class="campus-nav__link" href="#products">상품</a>
          {showCases && <a class="campus-nav__link" href="#cases">사례</a>}
          <a class="campus-nav__link" href="#faq">자주 묻는 질문</a>
          {applyReady ? (
            <a class="btn btn--primary" href={applyFormUrl!} rel="noopener">신청하기</a>
          ) : (
            <span class="btn is-disabled" aria-disabled="true">신청 준비 중</span>
          )}
        </div>
      </nav>

      <main id="main" class="campus">
        <!-- Hero -->
        <section id="top" class="campus-hero">
          <span class="eyebrow">{hero.eyebrow}</span>
          <h1 class="campus-hero__title">{hero.title}</h1>
          <p class="campus-hero__subtitle">{hero.subtitle}</p>
          <div class="campus-hero__actions">
            <a class="btn btn--primary" href="#products">상품 보기</a>
            <a class="btn btn--ghost" href="#faq">자주 묻는 질문</a>
          </div>
        </section>

        <!-- Difference between the two products -->
        <section class="campus-section" aria-label="두 상품의 차이">
          <div class="campus-difference">
            <div class="campus-diff-card">
              <p class="campus-diff-card__price">얼리버드 커리어 프로필 · 49,000원</p>
              <p class="campus-diff-card__line">{difference.earlybird}</p>
            </div>
            <div class="campus-diff-card">
              <p class="campus-diff-card__price">Interview Portfolio · 199,000원</p>
              <p class="campus-diff-card__line">{difference.interviewPortfolio}</p>
            </div>
          </div>
        </section>

        <!-- Products -->
        <section id="products" class="campus-section">
          <div class="campus-section__head">
            <h2 class="campus-section__title">필요한 만큼 골라서 시작하세요</h2>
            <p class="campus-section__lead">
              두 상품 모두 자료를 직접 읽고 문장을 다듬어 만듭니다. 차이는 품질이
              아니라 실제 작업 범위입니다.
            </p>
          </div>

          <div class="campus-products">
            {products.map((product) => (
              <article
                class:list={[
                  "campus-product",
                  product.featured && "campus-product--featured",
                ]}
              >
                <div class="campus-product__head">
                  <div class="campus-product__badges">
                    {product.priceBadge && (
                      <span class="badge">{product.priceBadge}</span>
                    )}
                  </div>
                  <h3 class="campus-product__name">{product.name}</h3>
                  {product.koreanLabel && (
                    <p class="campus-product__ko">{product.koreanLabel}</p>
                  )}
                  <div class="campus-product__price-row">
                    <span class="campus-product__price">{product.price}</span>
                  </div>
                  {product.priceNote && (
                    <p class="campus-product__price-note">{product.priceNote}</p>
                  )}
                </div>

                <p class="campus-product__tagline">{product.tagline}</p>
                <p class="campus-product__summary">{product.summary}</p>

                <div class="campus-product__group">
                  <ul class="campus-list">
                    <li class="campus-list__label">포함</li>
                    {product.includes.map((item) => (
                      <li class="campus-list__item">{item}</li>
                    ))}
                  </ul>
                </div>

                {product.excludes && (
                  <div class="campus-product__group">
                    <ul class="campus-list campus-list--muted">
                      <li class="campus-list__label">포함하지 않음</li>
                      {product.excludes.map((item) => (
                        <li class="campus-list__item">{item}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {product.conditional && (
                  <div class="campus-product__group">
                    <ul class="campus-list campus-list--muted">
                      <li class="campus-list__label">기술 검토 후 함께 논의</li>
                      {product.conditional.map((item) => (
                        <li class="campus-list__item">{item}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>

        <!-- Cases (rendered only when there is a consented case, or in review mode) -->
        {showCases && (
          <section id="cases" class="campus-section">
            {REVIEW_MODE && (
              <p class="campus-review-banner">
                <strong>내부 검수 · 배포 금지</strong> — 아래 사례는 공개
                동의(approvedForCampus) 전 후보입니다. 프로덕션 빌드에는
                노출되지 않으며, 개인 연락처는 표시하지 않습니다.
              </p>
            )}
            <div class="campus-section__head">
              <h2 class="campus-section__title">이렇게 정리됩니다</h2>
              <p class="campus-section__lead">
                실제로 만든 커리어 프로필입니다. 각 링크는 본인이 공개한
                페이지로 연결됩니다.
              </p>
            </div>
            <div class="campus-cases">
              {visibleCases.map((c) => {
                const href = caseHref(c);
                const external = Boolean(c.externalUrl && !c.slug);
                return (
                  <a
                    class="campus-case"
                    href={href}
                    {...(external
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    <span class="campus-case__role">{c.role}</span>
                    <span class="campus-case__name">
                      {c.name}
                      {c.englishName && <span>{c.englishName}</span>}
                    </span>
                    <span class="campus-case__blurb">{c.blurb}</span>
                    <span class="campus-case__link">
                      프로필 보기 {external ? "↗" : "→"}
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        <!-- Review / feedback note -->
        <section class="campus-section" aria-label="초기 고객 피드백 안내">
          <div class="campus-section__head">
            <h2 class="campus-section__title">첫 10명 초기 고객께 드리는 말</h2>
          </div>
          <p class="campus-note">{reviewNote}</p>
        </section>

        <!-- FAQ -->
        <section id="faq" class="campus-section">
          <div class="campus-section__head">
            <h2 class="campus-section__title">자주 묻는 질문</h2>
          </div>
          <div class="campus-faq">
            {faqs.map((faq) => (
              <div class="campus-faq__item">
                <p class="campus-faq__q">{faq.q}</p>
                <p class="campus-faq__a">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Apply CTA -->
        <section id="apply" class="campus-apply">
          <h2 class="campus-apply__title">지금 가진 자료로 어떤 페이지를 만들 수 있는지 함께 정리해 드려요</h2>
          {applyReady ? (
            <>
              <p class="campus-apply__note">
                신청했다고 바로 결제되지 않습니다. 지원 직무와 현재 자료를
                확인한 뒤, 가능한 구성과 적합한 상품 범위를 안내드립니다.
              </p>
              <a class="btn btn--primary" href={applyFormUrl!} rel="noopener">
                구성 상담 신청
              </a>
            </>
          ) : (
            <>
              <p class="campus-apply__note">
                온라인 신청 접수는 준비 중입니다. 신청 폼이 연결되면 이곳에서
                바로 신청할 수 있게 됩니다.
              </p>
              <span class="btn is-disabled" aria-disabled="true">
                온라인 신청 준비 중
              </span>
              <p class="campus-apply__status">Preview · 신청 접수 준비 중</p>
            </>
          )}
        </section>
      </main>

      <WeThruFooter />
    </div>
  </body>
</html>
