---
import WeThruFooter from "../components/profile/WeThruFooter.astro";
import DemoProfileScreen from "../components/campus-v3/DemoProfileScreen.astro";
import DemoProjectScreen from "../components/campus-v3/DemoProjectScreen.astro";
import {
  campusV3Offer,
  campusV3Demos,
  campusV3DemoPersona,
  approvedV3Cases,
} from "../data/campus-v3";
import "../styles/global.css";
import "../styles/profile-base.css";
import "../styles/themes/cobalt-air.css";
import "../styles/campus-v3.css";

// Internal case-review mode. Off by default, so a normal `npm run build`
// (including every Vercel deploy) produces the PRODUCTION page. Turn it on only
// for local review:  CAMPUS_REVIEW=1 npm run build  (or npm run dev).
// Read the build-time env without depending on @types/node globals.
const nodeEnv = (
  globalThis as { process?: { env?: Record<string, string | undefined> } }
).process?.env;
const REVIEW_MODE = nodeEnv?.CAMPUS_REVIEW === "1";

const { hero, problems, difference, products, process, boundaries, reviewNote, faqs, applyFormUrl } =
  campusV3Offer;

// Cases: production shows only consented ones (currently none). Review mode
// additionally surfaces the unapproved candidates behind a "배포 금지" banner.
// Gating is server-side, so unapproved names never enter the production HTML.
const visibleCases = REVIEW_MODE ? campusV3Offer.cases : approvedV3Cases;
const showCases = visibleCases.length > 0;

const applyReady = applyFormUrl !== null;
// No verified apply URL yet, or an internal review build → keep it out of index.
const noindex = !applyReady || REVIEW_MODE;

const caseHref = (
  c: (typeof campusV3Offer.cases)[number],
): string | undefined =>
  c.slug ? `/profiles/${c.slug}/` : (c.externalUrl ?? undefined);

const site = Astro.site ?? new URL("https://profile.wethru.com");
const canonicalUrl = new URL("/campus-v3/", site);

const seoTitle = "WeThru Campus — 흩어진 경험을 하나의 커리어 웹페이지로";
const seoDescription =
  "인턴·공모전·프로젝트·노션·깃허브까지 흩어진 자료를 읽히는 순서로 정리한 커리어 웹페이지. 얼리버드 커리어 프로필(49,000원)과 Interview Portfolio(199,000원) 두 가지로 시작합니다.";

const demoProfile = campusV3Demos[0];
const demoProject = campusV3Demos[1];
---

<html lang="ko" data-theme="cobalt-air" data-effects="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="WeThru Campus" />
    <meta property="og:locale" content="ko_KR" />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="profile-shell">
      <a class="skip-link" href="#main">본문으로 건너뛰기</a>

      <!-- 1. Sticky navigation -->
      <nav class="v3-nav" aria-label="Campus">
        <a class="v3-nav__brand" href="#top">
          <span class="v3-nav__mark" aria-hidden="true">W</span>
          WeThru Campus
        </a>
        <div class="v3-nav__links">
          <a class="v3-nav__link" href="#preview">결과물</a>
          <a class="v3-nav__link" href="#products">상품</a>
          {showCases && <a class="v3-nav__link" href="#cases">사례</a>}
          <a class="v3-nav__link" href="#faq">자주 묻는 질문</a>
          {applyReady ? (
            <a class="btn btn--ink" href={applyFormUrl!} rel="noopener">신청하기</a>
          ) : (
            <a class="btn btn--ink" href="#apply">49,000원 신청</a>
          )}
        </div>
      </nav>

      <main id="main" class="campus-v3">
        <!-- 2. Hero -->
        <section id="top" class="v3-hero">
          <div class="v3-hero__copy">
            <span class="v3-eyebrow"><i class="v3-eyebrow__dot" aria-hidden="true"></i>{hero.eyebrow}</span>
            <h1 class="v3-hero__title" set:html={hero.title.replace(hero.highlight, `<span class="hl">${hero.highlight}</span>`)}></h1>
            <p class="v3-hero__subtitle">{hero.subtitle}</p>
            <div class="v3-hero__actions">
              <a class="btn btn--ink" href="#apply">{hero.primaryCtaLabel}</a>
              <a class="btn btn--ghost" href="#preview">{hero.secondaryCtaLabel}</a>
            </div>
            <ul class="v3-hero__proof">
              {hero.proof.map((p) => <li>{p}</li>)}
            </ul>
          </div>

          <div class="v3-showcase">
            <DemoProfileScreen />
            <div class="v3-showcase__sidecards">
              <div class="v3-sidecard">
                <span class="v3-sidecard__num">01 / BEFORE</span>
                <span class="v3-sidecard__line">노션·PDF·드라이브 링크가 따로 놀던 상태</span>
              </div>
              <div class="v3-sidecard v3-sidecard--after">
                <span class="v3-sidecard__num">02 / AFTER</span>
                <span class="v3-sidecard__line">링크 하나로 보내는 한 사람의 이야기</span>
              </div>
            </div>
          </div>
        </section>

        <!-- 3. 문제 3개 -->
        <section class="v3-section" aria-label="흩어진 자료의 문제">
          <div class="v3-section__head">
            <h2 class="v3-title">{problems.title}</h2>
            <p class="v3-lead">{problems.lead}</p>
          </div>
          <div class="v3-grid3">
            {problems.cards.map((c) => (
              <article class="v3-problem">
                <span class="v3-problem__num">{c.index}</span>
                <h3 class="v3-problem__title">{c.title}</h3>
                <p class="v3-problem__body">{c.body}</p>
              </article>
            ))}
          </div>
        </section>

        <!-- 4. 결과물 미리보기 (DEMO — always rendered, fictional) -->
        <section id="preview" class="v3-section v3-section--tint">
          <div class="v3-section__head">
            <span class="v3-demo-note"><strong>DEMO</strong> · 실제 고객 사례 아님</span>
            <h2 class="v3-title">두 상품이 실제로 어떻게 다른지, 화면으로 보여드립니다</h2>
            <p class="v3-lead">
              아래는 가상의 예시 인물({campusV3DemoPersona.demoName})로 만든 구성 예시입니다. 실제 고객의 정보나
              화면이 아니며, 신청 여부와 상관없이 항상 보여집니다.
            </p>
          </div>

          <div class="v3-demos">
            <!-- A. 얼리버드 1페이지 예시 -->
            <article class="v3-demo-card">
              <span class="v3-demo-card__badge">A · 얼리버드 예시</span>
              <p class="v3-demo-card__label">{demoProfile.label}</p>
              <div class="v3-demo-card__stage">
                <DemoProfileScreen />
              </div>
              <a class="v3-demo-card__link" href={demoProfile.href}>{demoProfile.hrefLabel}</a>
            </article>

            <!-- B. Interview Portfolio 프로젝트 상세 예시 -->
            <article class="v3-demo-card v3-demo-card--ip">
              <span class="v3-demo-card__badge">B · Interview Portfolio 예시</span>
              <p class="v3-demo-card__label">{demoProject.label}</p>
              <div class="v3-demo-card__stage">
                <DemoProjectScreen />
              </div>
              <a class="v3-demo-card__link" href={demoProject.href}>{demoProject.hrefLabel}</a>
            </article>
          </div>
        </section>

        <!-- 5. 승인된 실제 사례 (consent-gated; hidden entirely when 0 approvals) -->
        {showCases && (
          <section id="cases" class="v3-section">
            {REVIEW_MODE && (
              <p class="v3-review-banner">
                <strong>내부 검수 · 배포 금지</strong> — 아래 사례는 공개
                동의(approvedForCampus) 전 후보입니다. 프로덕션 빌드에는
                노출되지 않으며, 개인 연락처는 표시하지 않습니다.
              </p>
            )}
            <div class="v3-section__head">
              <h2 class="v3-title">실제 제작 사례</h2>
              <p class="v3-lead">
                실제로 만든 커리어 프로필입니다. 각 링크는 본인이 공개한
                페이지로 연결됩니다.
              </p>
            </div>
            <div class="v3-cases">
              {visibleCases.map((c) => {
                const href = caseHref(c);
                const external = Boolean(c.externalUrl && !c.slug);
                return (
                  <a
                    class="v3-case"
                    href={href}
                    {...(external
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    <span class="v3-case__role">{c.role}</span>
                    <span class="v3-case__name">
                      {c.name}
                      {c.englishName && <span>{c.englishName}</span>}
                    </span>
                    <span class="v3-case__blurb">{c.blurb}</span>
                    <span class="v3-case__link">
                      프로필 보기 {external ? "↗" : "→"}
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        <!-- 6. 두 상품 비교 -->
        <section id="products" class="v3-section v3-section--tint">
          <div class="v3-section__head">
            <h2 class="v3-title">필요한 만큼 골라서 시작하세요</h2>
            <p class="v3-lead">
              두 상품 모두 자료를 직접 읽고 문장을 다듬어 만듭니다. 차이는 품질이
              아니라 실제 작업 범위입니다. 얼리버드는 「{difference.earlybird}」,
              Interview Portfolio는 「{difference.interviewPortfolio}」.
            </p>
          </div>

          <div class="v3-products">
            {products.map((product) => (
              <article
                class:list={[
                  "v3-product",
                  product.featured && "v3-product--ip",
                ]}
              >
                <div class="v3-product__head">
                  <div class="v3-product__badges">
                    {product.priceBadge && (
                      <span class="v3-product__badge">{product.priceBadge}</span>
                    )}
                  </div>
                  <h3 class="v3-product__name">{product.name}</h3>
                  {product.koreanLabel && (
                    <p class="v3-product__ko">{product.koreanLabel}</p>
                  )}
                  <div class="v3-product__price-row">
                    <span class="v3-product__price">{product.price}</span>
                  </div>
                  {product.priceNote && (
                    <p class="v3-product__price-note">{product.priceNote}</p>
                  )}
                </div>

                <div class="v3-product__body">
                  {product.featuredBadge && (
                    <span class="v3-product__ip-badge">{product.featuredBadge}</span>
                  )}
                  <p class="v3-product__tagline">{product.tagline}</p>
                  <p class="v3-product__summary">{product.summary}</p>

                  <ul class="v3-list">
                    <li class="v3-list__label">포함 (핵심)</li>
                    {product.coreIncludes.map((item) => (
                      <li class="v3-list__item">{item}</li>
                    ))}
                  </ul>

                  <details class="v3-more">
                    <summary>세부 범위 보기</summary>
                    <div class="v3-more__inner">
                      <ul class="v3-list">
                        {product.moreIncludes.map((item) => (
                          <li class="v3-list__item">{item}</li>
                        ))}
                      </ul>
                      {product.excludes && (
                        <ul class="v3-list v3-list--muted">
                          <li class="v3-list__label">포함하지 않음</li>
                          {product.excludes.map((item) => (
                            <li class="v3-list__item">{item}</li>
                          ))}
                        </ul>
                      )}
                      {product.conditional && (
                        <ul class="v3-list v3-list--muted">
                          <li class="v3-list__label">기술 검토 후 함께 논의</li>
                          {product.conditional.map((item) => (
                            <li class="v3-list__item">{item}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </details>
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- 7. 진행 방식 -->
        <section class="v3-section" aria-label="진행 방식">
          <div class="v3-section__head">
            <h2 class="v3-title">자료만 보내면 이 순서로 완성됩니다</h2>
          </div>
          <div class="v3-process">
            {process.map((s) => (
              <article class="v3-step">
                <span class="v3-step__num">{s.step}</span>
                <h3 class="v3-step__title">{s.title}</h3>
                <p class="v3-step__body">{s.body}</p>
              </article>
            ))}
          </div>
        </section>

        <!-- 8. 포함하지 않는 범위 + 초기 고객 안내 -->
        <section class="v3-section v3-section--tint" aria-label="포함하지 않는 범위">
          <div class="v3-section__head">
            <h2 class="v3-title">미리 분명히 해두는 범위</h2>
            <p class="v3-lead">과장하지 않기 위해, 이 상품이 하지 않는 것을 먼저 적어둡니다.</p>
          </div>
          <ul class="v3-boundaries">
            {boundaries.map((b) => <li>{b}</li>)}
          </ul>
          <p class="v3-lead" style="margin-top:1.4rem">{reviewNote}</p>
        </section>

        <!-- 9. FAQ accordion -->
        <section id="faq" class="v3-section">
          <div class="v3-section__head">
            <h2 class="v3-title">자주 묻는 질문</h2>
          </div>
          <div class="v3-faq">
            {faqs.map((faq) => (
              <details class="v3-faq__item">
                <summary class="v3-faq__q">{faq.q}</summary>
                <div class="v3-faq__a">{faq.a}</div>
              </details>
            ))}
          </div>
        </section>

        <!-- 10. 신청 CTA -->
        <section id="apply" class="v3-apply">
          <h2 class="v3-apply__title">지금 가진 자료로 어떤 커리어 페이지를 만들 수 있는지 함께 정리해 드려요</h2>
          {applyReady ? (
            <>
              <p class="v3-apply__note">
                신청했다고 바로 결제되지 않습니다. 지원 직무와 현재 자료를
                확인한 뒤, 가능한 구성과 적합한 상품 범위를 안내드립니다.
              </p>
              <a class="btn btn--ink" href={applyFormUrl!} rel="noopener">
                구성 상담 신청
              </a>
            </>
          ) : (
            <>
              <p class="v3-apply__note">
                온라인 신청 접수는 준비 중입니다. 신청 폼이 연결되면 이곳에서
                바로 신청할 수 있게 됩니다.
              </p>
              <span class="btn is-disabled" aria-disabled="true">
                온라인 신청 준비 중
              </span>
              <p class="v3-apply__status">Preview · 신청 접수 준비 중</p>
            </>
          )}
        </section>
      </main>

      <!-- 11. Footer -->
      <WeThruFooter />
    </div>
  </body>
</html>
