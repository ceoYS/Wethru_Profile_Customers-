---
/**
 * Operator dashboard — INTERNAL ONLY, and never built into a public deploy.
 *
 * This page lists every customer by real name and links straight at
 * /profiles/{slug}/ plus the external customer deploys. That is exactly the
 * material a public origin must not carry, so it is gated at BUILD time rather
 * than at render time: getStaticPaths returns an empty array unless
 * INTERNAL_DASHBOARD=1, and Astro then emits no HTML file for this route at all.
 * A public build has no dist/index.html to leak — not a hidden one, not an empty
 * one. career.wethru.com/ is served from /campus-v4/ by the rewrite in
 * vercel.json, so the public root is the Campus landing, never this page.
 *
 * Why a rest-param route and not index.astro: a plain static page is always
 * emitted, so there is no way to skip it. `[...dashboard]` is a dynamic route,
 * so getStaticPaths decides whether it exists at all. Returning
 * `{ params: { dashboard: undefined } }` maps back to "/", keeping the internal
 * build's URL exactly what it has always been. Static routes take precedence
 * over dynamic ones in Astro, and a dynamic route in a static build only ever
 * emits the paths it returns — so this cannot shadow /campus-v4/, /campus/ or
 * /profiles/{slug}/.
 *
 * The customer modules are pulled in with `await import()` INSIDE the gated
 * branch instead of as top-level imports. On a public build this route never
 * touches customer-index or external-profiles, so no name, slug, email, link or
 * face-image reference can reach the build output through this file.
 *
 * The flag is deliberately NOT prefixed with PUBLIC_. Astro/Vite only inlines
 * PUBLIC_* env vars into client-side code; a bare name stays build-time only and
 * can never appear in a browser bundle.
 *
 *   npm run build                      → public: no dashboard, no customer list
 *   INTERNAL_DASHBOARD=1 npm run build → internal: dashboard at /, as before
 *
 * Nothing is deleted or reduced here — the dashboard markup and the customer
 * data are preserved in full for the internal build.
 */
import type { CustomerProfile } from "../types/profile";
import type { ExternalProfile } from "../data/external-profiles";
import { localize } from "../utils/i18n";
import "../styles/global.css";
import "../styles/profile-base.css";
import "../styles/themes/navy-black-white.css";
import "../styles/themes/warm-editorial.css";
import "../styles/themes/graphite-minimal.css";
import "../styles/themes/cobalt-air.css";
import "../styles/themes/terracotta-atelier.css";

export async function getStaticPaths() {
  // getStaticPaths runs in its own build scope — read the flag here. Same safe
  // env read as campus-v4.astro (no dependency on @types/node globals).
  const env = (
    globalThis as { process?: { env?: Record<string, string | undefined> } }
  ).process?.env;

  // FAIL-CLOSED: anything other than an explicit "1" produces zero pages, and a
  // normal `npm run build` — which is every Vercel deploy — takes this branch.
  if (env?.INTERNAL_DASHBOARD !== "1") return [];

  const [{ publishedCustomers, draftCustomers }, { externalProfiles }] =
    await Promise.all([
      import("../data/customer-index"),
      import("../data/external-profiles"),
    ]);

  return [
    {
      // A rest param of `undefined` resolves to the route's own root → "/".
      params: { dashboard: undefined },
      props: { publishedCustomers, draftCustomers, externalProfiles },
    },
  ];
}

interface Props {
  publishedCustomers: CustomerProfile[];
  draftCustomers: CustomerProfile[];
  externalProfiles: ExternalProfile[];
}

const { publishedCustomers, draftCustomers, externalProfiles } = Astro.props;
---

<html lang="ko" data-theme="navy-black-white">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WeThru Profile Customers</title>
    <meta
      name="description"
      content="WeThru 고객 온라인 명함/프로필 관리 대시보드"
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="profile-shell">
      <main class="dashboard">
        <span class="eyebrow">WeThru — Profile Factory</span>
        <h1 class="dashboard__title">WeThru Profile Customers</h1>
        <p class="dashboard__subtitle">
          고객 온라인 명함/프로필 관리 페이지입니다. 새 고객은
          <code>npm run new:profile</code>로 추가하고, 배포 전
          <code>npm run validate:customers</code>를 실행합니다.
        </p>

        <div class="dashboard__grid">
          {publishedCustomers.map((customer) => (
            <a class="customer-card" href={`/profiles/${customer.slug}/`}>
              <div class="customer-card__meta">
                <span class="eyebrow">{localize(customer.person.roleLine)}</span>
                <span class="customer-card__status customer-card__status--published">
                  published
                </span>
              </div>
              <h2 class="customer-card__name">
                {customer.person.name}
                {customer.person.englishName && ` · ${customer.person.englishName}`}
              </h2>
              <p class="customer-card__tagline">{localize(customer.person.tagline)}</p>
              <p class="customer-card__tags">
                <span>{customer.theme}</span>
                <span>{customer.layout}</span>
              </p>
            </a>
          ))}

          {/* Profiles delivered as their own repo + their own deploy. They have
              no module in src/data/customers/, so the glob above cannot reach
              them — without this they silently disappear from the dashboard.
              Same card, dashed edge, and a link that leaves this origin. */}
          {externalProfiles.map((profile) => (
            <a
              class="customer-card customer-card--external"
              href={profile.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="customer-card__meta">
                <span class="eyebrow">{profile.roleLine}</span>
                <span class="customer-card__status customer-card__status--published">
                  published
                </span>
              </div>
              <h2 class="customer-card__name">
                {profile.name} · {profile.englishName}
              </h2>
              <p class="customer-card__tagline">{profile.tagline}</p>
              <p class="customer-card__tags">
                <span>{profile.theme}</span>
                <span>{profile.layout}</span>
                <span class="customer-card__external">
                  외부 저장소 ↗<span class="visually-hidden">, 새 탭에서 열림</span>
                </span>
              </p>
            </a>
          ))}
        </div>

        {externalProfiles.length > 0 && (
          <p class="dashboard__external-note">
            ↗ 표시된 카드는 이 저장소가 아니라 고객 전용 저장소에서 따로 배포된
            프로필입니다. <code>npm run validate:customers</code> 검사 대상이
            아니며, 내용 수정은 각 원본 저장소에서 진행합니다 (이준구:{" "}
            <code>references/lee-jungu-profile</code>).
          </p>
        )}

        <p class="dashboard__drafts">
          내부 페이지 ·{" "}
          <a href="/campus/">Campus 오퍼 페이지</a>{" "}
          <span style="color: var(--muted)">(검수용 · noindex)</span>
        </p>

        {draftCustomers.length > 0 && (
          <p class="dashboard__drafts">
            Drafts:{" "}
            {draftCustomers.map((customer, index) => (
              <>
                {index > 0 && " · "}
                <a href={`/profiles/${customer.slug}/`}>
                  {customer.person.name || customer.slug}
                </a>
              </>
            ))}
          </p>
        )}
      </main>

      <footer class="wethru-footer">
        <p class="wethru-footer__mark">WeThru internal — do not share</p>
      </footer>
    </div>
  </body>
</html>

<style>
  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--accent);
    border: 1px solid var(--line-soft);
    border-radius: 4px;
    padding: 0.1em 0.4em;
  }
</style>
