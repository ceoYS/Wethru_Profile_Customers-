---
import WeThruFooter from "../../../components/profile/WeThruFooter.astro";
import DemoProfileScreen from "../../../components/campus-v3/DemoProfileScreen.astro";
import "../../../styles/global.css";
import "../../../styles/profile-base.css";
import "../../../styles/themes/cobalt-air.css";
import "../../../styles/campus-v3.css";

// Internal demo screen. Always noindex — it is a fictional sample on the
// not-yet-launched /campus-v3/ route, never a real customer page.
const site = Astro.site ?? new URL("https://profile.wethru.com");
const canonicalUrl = new URL("/campus-v3/demo/profile/", site);
const seoTitle = "DEMO · 얼리버드 커리어 프로필 구성 예시 — WeThru Campus";

const elements = [
  "1페이지 첫 화면 — 소개 문장과 핵심 경험이 먼저 보이는 구성",
  "한 문장 자기소개",
  "핵심 경험 3개",
  "프로젝트 요약 1개",
  "이력서·노션·깃허브 등 외부 링크 연결",
  "모바일·PC 반응형 화면",
];
---

<html lang="ko" data-theme="cobalt-air" data-effects="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content="가상 예시 인물로 만든 얼리버드 커리어 프로필 구성 예시입니다. 실제 고객 사례가 아닙니다." />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="profile-shell">
      <a class="skip-link" href="#main">본문으로 건너뛰기</a>
      <main id="main" class="campus-v3 v3-demo-page">
        <a class="v3-back" href="/campus-v3/#preview">결과물 미리보기로 돌아가기</a>

        <p class="v3-demo-page__banner">
          <strong>DEMO · 실제 고객 사례 아님</strong> — 아래 화면은 가상의 예시
          인물(가온)로 만든 구성 예시입니다. 실제 고객의 정보·화면·후기가 아니며,
          학교·회사·수치는 담고 있지 않습니다.
        </p>

        <div class="v3-demo-page__grid">
          <div class="v3-demo-page__copy">
            <h1>얼리버드 커리어 프로필 · 구성 예시</h1>
            <p>흩어진 자료를 읽히는 순서로 정리한 맞춤형 1페이지가 어떻게 구성되는지, 가상 예시로 보여드립니다. 49,000원 얼리버드 커리어 프로필의 실제 결과물 형태입니다.</p>
            <ul class="v3-list" style="margin-top:1.25rem">
              <li class="v3-list__label">이 구성에 담기는 것</li>
              {elements.map((e) => <li class="v3-list__item">{e}</li>)}
            </ul>
            <p class="v3-demo-page__note">
              오른쪽 화면은 실제 서비스가 아니라, 얼리버드 커리어 프로필이 어떤
              순서로 읽히는지 보여주기 위한 예시입니다.
            </p>
          </div>

          <DemoProfileScreen />
        </div>
      </main>
      <WeThruFooter />
    </div>
  </body>
</html>
